{
  "name": "snippetvault",
  "version": "1.0.0",
  "description": "Personal code snippet manager with tagging and search",
  "main": "src/snippetvault.js",
  "bin": {
    "snippetvault": "src/snippetvault.js"
  },
  "scripts": {
    "start": "node src/snippetvault.js",
    "test": "node --test src/*.test.js 2>/dev/null || echo 'No tests — add tests in src/*.test.js'",
    "lint": "eslint src/ --ext .js",
    "tracker": "node src/achievement-tracker.js",
    "roadmap": "node src/achievement-tracker.js"
  },
  "keywords": ["snippets", "code", "manager", "cli", "search", "tags"],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
